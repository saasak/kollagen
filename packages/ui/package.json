{
	"name": "@saasak/kollagen",
	"version": "1.0.5",
	"description": "Ready-to-use, themed SvelteKit components built on bits-ui",
	"type": "module",
	"bin": {
		"kollagen": "dist/cli/index.js"
	},
	"scripts": {
		"build": "tsup && rm -rf dist/themes && cp -r src/templates/theme dist/themes",
		"dev": "tsup --watch",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.svelte.json"
	},
	"files": [
		"dist",
		"src/templates"
	],
	"dependencies": {
		"@clack/prompts": "^0.10.0",
		"commander": "^13.1.0",
		"nypm": "^0.6.0"
	},
	"devDependencies": {
		"@internationalized/date": "^3.8.2",
		"@types/node": "^22.13.10",
		"bits-ui": "latest",
		"embla-carousel": "latest",
		"embla-carousel-autoplay": "latest",
		"embla-carousel-svelte": "latest",
		"lucide-svelte": "latest",
		"paneforge": "latest",
		"svelte": "latest",
		"svelte-check": "latest",
		"svelte-sonner": "latest",
		"tsup": "^8.4.0",
		"typescript": "^5.8.2",
		"uqr": "latest",
		"vaul-svelte": "1.0.0-next.7"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"ui",
		"bits-ui",
		"jsrepo"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22"
	}
}
