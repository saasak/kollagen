#!/usr/bin/env bash
eval "$(mise activate bash)" || true

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|svelte|html|css|json|postcss|md)$' || true)
ESLINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|js|svelte)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running prettier & eslint on staged files..."
echo "$STAGED_FILES" | xargs pnpm exec prettier --write || true
if [ -n "$ESLINT_FILES" ]; then
  echo "$ESLINT_FILES" | xargs pnpm exec eslint --fix || true
fi
echo "$STAGED_FILES" | xargs git add || true

exit 0
